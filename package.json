{
  "name": "lingomuse",
  "version": "1.1.1",
  "description": "A private, zero-cost, on-device Chinese-English translation companion.",
  "author": "LingoMuse",
  "license": "MIT",
  "homepage": "https://scotteliu.github.io/LingoMuse/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ScotteLiu/LingoMuse.git"
  },
  "bugs": {
    "url": "https://github.com/ScotteLiu/LingoMuse/issues"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "test": "vitest run",
    "test:electron": "cross-env LINGOMUSE_SMOKE_TEST=1 electron .",
    "test:ui": "vite build && electron tests/ui-capture.cjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && vitest run && vite build",
    "site:build": "node scripts/build-site.mjs",
    "package:win": "vite build && electron-builder --win nsis --x64 --config.artifactName=LingoMuse-${version}-${os}-${arch}-Setup.${ext} && electron-builder --win portable --x64 --config.artifactName=LingoMuse-${version}-${os}-${arch}-Portable.${ext}",
    "package:offline": "vite build && electron-builder --config electron-builder.offline.yml --win dir --x64"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "tw.lingomuse.desktop",
    "productName": "LingoMuse 靈譯",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "PRIVACY.md"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LingoMuse 靈譯",
      "installerLanguages": [
        "zh_TW",
        "en_US"
      ]
    },
    "artifactName": "LingoMuse-${version}-${os}-${arch}.${ext}"
  }
}
